# Local browser build-time values. Keep the proxy URL empty in development;
# Pages sets the public /api/__clerk URL during a production build.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Local backend runtime values. Clerk and MongoDB are optional for guest
# catalog browsing; signed-in account features require Clerk and MongoDB.
FRONTEND_ORIGIN=http://localhost:5000
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MONGODB_URI=
MONGODB_DB_NAME=wave_tune

# Set these on the hosting providers, not for local development:
# FRONTEND_ORIGIN=https://your-pages-domain.example
# WAVE_TUNE_API_ORIGIN=https://your-render-service.onrender.com
